# Toy Blockchain configuration.
# Copy to `.env` (git-ignored) and edit. Every value is optional: the binary
# falls back to the defaults in internal/config/config.go.
#
# Precedence: defaults < .env file < real environment variables < CLI flags.

# Number of leading zero HEX digits a block hash must have to be valid.
# Each extra digit multiplies the expected work by ~16.
# 4 mines in well under a second on a laptop; 6 takes a few seconds.
TBC_DIFFICULTY=4

# Maximum number of transactions packed into a single block.
TBC_MAX_TX_PER_BLOCK=10

# Where the chain is persisted as JSON between runs.
TBC_DATA_FILE=data/chain.json

# Local keystore: private keys, never part of the chain. Keep it out of git.
TBC_KEY_FILE=data/keys.json

# Account credited with the coinbase reward of every block mined by this node.
TBC_MINER_ADDRESS=miner

# Coins created out of thin air and paid to TBC_MINER_ADDRESS per mined block.
TBC_MINING_REWARD=50
